[Unit]
Description=Dating App Gunicorn
After=network.target

[Service]
User=jk
Group=jk
WorkingDirectory=/home/jk/space/dating_app
Environment="PATH=/home/jk/space/dating_app/.venv/bin"
Environment="FLASK_ENV=production"
EnvironmentFile=-/home/jk/space/dating_app/.env
ExecStart=/home/jk/space/dating_app/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 --access-logfile - --error-logfile - "wsgi:app"
Restart=always

[Install]
WantedBy=multi-user.target
